# Copy this file to .env and fill in real values. .env is gitignored.

# Azure Document Intelligence resource (Azure Portal -> your resource -> Keys and Endpoint)
AZURE_DOC_INTEL_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=

# Azure AI Foundry Claude Sonnet-5 deployment
# ENDPOINT is the Foundry project's Anthropic-compatible base URL for this deployment
# (Azure AI Foundry portal -> your project -> Models + endpoints -> the Claude deployment).
AZURE_FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_API_KEY=
# The deployment/model name as configured in Foundry (defaults to claude-sonnet-5 if unset).
AZURE_FOUNDRY_CLAUDE_DEPLOYMENT=claude-sonnet-5

# Optional: DPI used when rasterizing PDF pages for vision input (default 200).
RENDER_DPI=200

# Optional: DPI ceiling used when re-rendering a single drawing's cropped
# bounding box for the higher-resolution detail pass (default 600). This is a
# ceiling, not a fixed value -- the actual DPI used is whatever fits under
# Claude's per-image size limits for that crop's physical size.
DETAIL_RENDER_DPI=600
